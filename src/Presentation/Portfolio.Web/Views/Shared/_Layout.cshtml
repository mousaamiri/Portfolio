@*
    _Layout.cshtml — shared shell for all PUBLIC pages
    ---------------------------------------------------------------------------
    The navbar, footer, command palette, accent-color picker and scroll-progress
    button are all built CLIENT-SIDE by their component scripts (navbar builds
    into #navbar; footer/palette/accent inject into <body>) — the markup ships
    empty placeholders and hydrates them with JS.
    Routing is wired for MVC via window.__navConfig.routes (the SPA-router runs
    on MVC routes; #page-content == @RenderBody()).

    Login / Forgot-Password use their OWN minimal layout (Layout = null) — they
    must NOT inherit this shell.
*@
@inject Portfolio.Web.Localization.LocalizationState Loc
@{
    var uiJson = System.Text.Json.JsonSerializer.Serialize(Loc.Map);

    // ── SEO ──────────────────────────────────────────────────────────────────
    // Absolute base + canonical (path only, query stripped) for OG/canonical/hreflang.
    var seoBase = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var seoPath = Context.Request.Path.HasValue ? Context.Request.Path.Value : "/";
    var canonicalUrl = seoBase + seoPath;
    var pageTitle = Html.TA((string)(ViewData["I18nTitle"] ?? ""), $"{ViewData["Title"]} — Portfolio");
    var pageDescription = (string)(ViewData["Description"] ?? "Portfolio of Mousa Amiri Motlagh — Backend Engineer");
    var ogImage = seoBase + Url.Content((string)(ViewData["OgImage"] ?? "~/images/about-portrait.jpg"));
    // OG locale: BCP-47-ish region tags for the supported languages.
    var ogLocale = Loc.Language switch { "fa" => "fa_IR", "ar" => "ar", _ => "en_US" };
}
<!DOCTYPE html>
<html lang="@Loc.Language" dir="@Loc.Dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@pageDescription" />
    <link rel="icon" type="image/svg+xml" href="~/images/favicon.svg" />
    <title>@pageTitle</title>

    @* ── Canonical + hreflang: each supported language is the same URL with ?lang=,
         mirroring SitemapController so search engines index every language. ── *@
    <link rel="canonical" href="@canonicalUrl" />
    @foreach (var lang in Portfolio.Web.Services.WebLanguage.Supported)
    {
        <link rel="alternate" hreflang="@lang" href="@($"{canonicalUrl}?lang={lang}")" />
    }
    <link rel="alternate" hreflang="x-default" href="@canonicalUrl" />

    @* ── Open Graph (Facebook, LinkedIn, Telegram…) ── *@
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MousaAmiri Portfolio" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@pageDescription" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:image" content="@ogImage" />
    <meta property="og:locale" content="@ogLocale" />

    @* ── Twitter Card ── *@
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@pageTitle" />
    <meta name="twitter:description" content="@pageDescription" />
    <meta name="twitter:image" content="@ogImage" />

    @* ── FOUC-prevention: set theme BEFORE paint. Language/dir are now rendered
         server-side on <html> (from the portfolio-lang cookie), so only the theme
         needs the pre-paint bootstrap. ── *@
    <script>
        (function(){var t;try{t=localStorage.getItem('portfolio-theme')}catch(e){}if(!t)t=matchMedia('(prefers-color-scheme:light)').matches?'light':'dark';document.documentElement.setAttribute('data-theme',t)})();
    </script>

    @* ── Latin webfonts (Farsi AzarMehr/Pinar are self-hosted via @@font-face in tokens.css) ── *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500;600;700;800&family=Instrument+Serif:ital@@1&family=JetBrains+Mono:wght@@400;500;700&display=swap" rel="stylesheet" />

    @* ── Design system: centralized tokens → base → layout → components → shell ── *@
    <link rel="stylesheet" href="~/css/tokens.css" />
    <link rel="stylesheet" href="~/css/base.css" />
    <link rel="stylesheet" href="~/css/layout.css" />
    <link rel="stylesheet" href="~/css/components.css" />
    <link rel="stylesheet" href="~/css/navbar.css" />
    <link rel="stylesheet" href="~/css/footer.css" />
    <link rel="stylesheet" href="~/css/theme-switcher.css" />
    <link rel="stylesheet" href="~/css/spa-transitions.css" />
    @* rtl.css last so [dir="rtl"] overrides win *@
    <link rel="stylesheet" href="~/css/rtl.css" />

    @RenderSection("Styles", required: false)
</head>
<body>

    @* Server-resolved language + DB-sourced UI-chrome map for the client-built
       components (navbar/footer/command palette). English → empty map (they use
       their inline English defaults). *@
    <script>
        window.__lang = '@Loc.Language';
        window.__ui = @Html.Raw(uiJson);
    </script>

    @* Navbar placeholder — hydrated by navbar-component.js *@
    <partial name="_Navigation" />

    <main id="page-content">
        @RenderBody()
    </main>

    @* Footer, command palette, accent picker & scroll-progress button are injected
       into <body> by their component scripts below (faithful to the static site). *@

    @* ── GSAP (shared by text-reveal.js and page animations, site-wide as in source) ── *@
    <script src="https://cdn.jsdelivr.net/npm/gsap@@3.13/dist/gsap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@@3.13/dist/ScrollTrigger.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@@3.13/dist/SplitText.min.js"></script>

    @* ── Shell config: MVC routes + current page for the ported navbar/router ── *@
    <script>
        window.__navConfig = {
            currentPage: '@(ViewData["ActivePage"] ?? "home")',
            routes: {
                home:       '@(Url.Action("Index", "Home") ?? "/")',
                about:      '@(Url.Action("Index", "About") ?? "/About")',
                experience: '@(Url.Action("Index", "Experience") ?? "/Experience")',
                work:       '@(Url.Action("Index", "Work") ?? "/Work")',
                blog:       '@(Url.Action("Index", "Blog") ?? "/Blog")',
                contact:    '@(Url.Action("Index", "Contact") ?? "/Contact")'
            }
        };
    </script>

    @* ── Shared shell scripts, in the exact source order. Page-specific scripts
         load in the PageScripts section BETWEEN text-reveal and navbar (matches
         the static site's <script src="home.js"> position — init timing intact).
         Localization is server-side now: chrome text comes from window.__ui
         (DB-sourced) + inline defaults; i18n.js is a thin server-backed shim. ── *@
    <script src="~/js/i18n.js"></script>
    <script src="~/js/navbar-component.js"></script>
    <script src="~/js/text-reveal.js"></script>

    @RenderSection("PageScripts", required: false)

    <script src="~/js/navbar.js"></script>
    <script src="~/js/command-palette.js"></script>
    <script src="~/js/footer-component.js"></script>
    <script src="~/js/theme-switcher.js"></script>
    <script src="~/js/spa-router.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
